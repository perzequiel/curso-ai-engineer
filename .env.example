# GitHub API Token
GITHUB_TOKEN=your_github_token_here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Repository (owner/repo)
GITHUB_REPO=owner/repository-name

# --- Persistencia ---------------------------------------------------------
# Backend del repositorio de reviews: "db"/"postgres" (default) o "memory".
REPOSITORY_BACKEND=db

# Postgres + pgvector (solo se usan si REPOSITORY_BACKEND=db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis
POSTGRES_DB=curso_ai
# Alternativa: setear DATABASE_URL completa tiene prioridad sobre lo de arriba.
# DATABASE_URL=postgresql+psycopg://app:changethis@localhost:5432/curso_ai

# Dimension del vector de embeddings (debe coincidir con la columna Vector(n)).
EMBEDDING_DIMENSIONS=1536
SQL_ECHO=false
